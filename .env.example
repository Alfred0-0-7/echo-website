# ECHO frontend (Next.js) environment variables.
#
# Copy this file to .env.local and set the backend URL.
# This is the ONLY backend URL the frontend needs — do not hardcode it anywhere.

# Local development (FastAPI running on your machine):
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example (your deployed Render backend):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
